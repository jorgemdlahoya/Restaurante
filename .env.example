# Copia este archivo a .env (`cp .env.example .env`) y sustituye los placeholders.
# .env está en .gitignore: nunca subas valores reales.

# Base de datos (contenedor `db`).
# docker-compose.yml compone DB_CONNECTION_STRING de la API con estos tres valores, así que no se
# repite aquí. La contraseña NO debe contener `;` (separador de la cadena de conexión).
# Fuera de compose la API sí lee DB_CONNECTION_STRING: ver docs/ONBOARDING.md.
POSTGRES_USER=<usuario-de-postgres>
POSTGRES_PASSWORD=<contrasena-de-postgres>
POSTGRES_DB=<nombre-de-la-base>

# Clave de firma JWT (HS256): mínimo 32 caracteres, aleatoria.
JWT_SIGNING_KEY=<clave-aleatoria-de-al-menos-32-caracteres>

# Orígenes permitidos por CORS, separados por comas.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Administrador inicial (se crea al arrancar si no hay usuarios).
ADMIN_USERNAME=<usuario-administrador>
ADMIN_PASSWORD=<contrasena-del-administrador>

# Production o Development (Swagger sólo en Development).
ASPNETCORE_ENVIRONMENT=Production
